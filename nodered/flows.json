  {
    "id": "dab52802dab52802",
    "type": "function",
    "z": "12b5c66012b5c660",
    "name": "aplicar preset",
    "func": "const presets = global.get('labPresets');\nconst lab = presets.apply(msg.payload);\nflow.set('lab', lab);\nconst sync = [\n    { topic: 'machine_status', payload: lab.machine_status },\n    { topic: 'heartbeat', payload: lab.heartbeat },\n    { topic: 'include.production', payload: !!(lab.include.total_count || lab.include.good_count || lab.include.reject_count) },\n    { topic: 'production.total_count', payload: lab.production.total_count },\n    { topic: 'energy.power_kw', payload: lab.energy.power_kw },\n    { topic: 'dyn.0.value', payload: (lab.dyn[0] && lab.dyn[0].value) || 0 },\n];\nreturn [sync, { lab }];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 140,
    "wires": [
